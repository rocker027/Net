<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.drake.net.sample.modern.DemoScenario" />

        <variable
            name="vm"
            type="com.drake.net.sample.modern.DemoMvvmViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        tools:context=".modern.ModernDataBindingFragment">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="DataBinding + StateFlow：布局直接绑定 vm.state，需设置 lifecycleOwner。" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> vm.load(DemoScenario.SUCCESS)}"
            android:text="请求成功" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> vm.load(DemoScenario.HTTP_ERROR)}"
            android:text="HTTP 503（全域错误提示）" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="@{() -> vm.load(DemoScenario.SLOW)}"
            android:text="慢请求（2 秒）" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:netLoading="@{vm.state}" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:netStateText="@{vm.state}" />

    </LinearLayout>
</layout>
